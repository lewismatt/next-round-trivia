{
  "name": "@next-round/game-trivia",
  "version": "0.1.0",
  "description": "Trivia — a simultaneous-answer quiz game for the Next Round platform.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "setup": "./scripts/fetch-core.sh && pnpm install && pnpm -r --filter @next-round/contracts --filter @next-round/game-sdk --filter @next-round/game-client run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@next-round/contracts": "workspace:*",
    "@next-round/game-sdk": "workspace:*",
    "@next-round/game-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.8",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
